+    /// A full-screen backdrop URL. Metahub serves the same art at 1920x1080 as `large`.
+    private static func backdropURL(_ raw: String?) -> URL? {
+        guard var address = raw?.trimmingCharacters(in: .whitespacesAndNewlines), !address.isEmpty else { return nil }
+        address = address.replacingOccurrences(of: "/background/medium/", with: "/background/large/")
+            .replacingOccurrences(of: "/background/small/", with: "/background/large/")
+        guard let url = URL(string: address), let scheme = url.scheme?.lowercased(),
+              scheme == "https" || scheme == "http" else { return nil }
+        return url
+    }
