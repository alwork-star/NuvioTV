+    /// Plays a stream meant for the default external player in the built-in player instead: a
+    /// hand-off that did not open, or a live stream (`LiveStreamRouting`). An auto start
+    /// (`autoAttempt`, 1-based) stays an auto start, so the walk continues on a failure.
+    private func playInNuvioInstead(url: URL, stream: StreamItem, listed: StreamItem, autoAttempt: Int?) {
+        NextEpisodeEngine.consecutiveAutoPlays = 0
+        if let autoAttempt {
+            selected = context(url: url, stream: stream, listedStream: listed, streamKey: listed.playbackStreamKey,
+                               launchSource: .autoPlay, attempt: autoAttempt - 1)
+        } else {
+            selected = context(url: url, stream: stream, listedStream: listed, streamKey: listed.playbackStreamKey,
+                               launchSource: .manual)
+        }
+    }
+
