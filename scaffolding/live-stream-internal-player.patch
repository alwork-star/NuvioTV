     /// runtime, else the title's catalog runtime. nil = unknown (the shared side then records the
     /// position without a tracker scrobble).
diff --git a/iosApp/NuvioTVTests/LiveStreamRoutingTests.swift b/iosApp/NuvioTVTests/LiveStreamRoutingTests.swift
new file mode 100644
index 0000000..7df3b16
--- /dev/null
+++ b/iosApp/NuvioTVTests/LiveStreamRoutingTests.swift
@@ -0,0 +1,47 @@
+import XCTest
+@testable import NuvioTV
+
+final class LiveStreamRoutingTests: XCTestCase {
+    func testHLSAndDASHManifestsAreStreaming() {
+        let live = [
+            "https://cdn.example.com/live/channel1/index.m3u8",
+            "https://cdn.example.com/hls/master.M3U8?token=abc&exp=123",
+            "http://iptv.example.net/playlist.m3u",
+            "https://dash.example.com/stream/manifest.mpd",
+            "  https://cdn.example.com/a/b/playlist.m3u8  ",
+            "https://cdn.example.com/a%20b/index.m3u8",
+        ]
+        for url in live { XCTAssertTrue(LiveStreamRouting.isStreamingManifest(url), url) }
+    }
+
+    func testIPTVLiveLayoutsAreStreaming() {
+        XCTAssertTrue(LiveStreamRouting.isStreamingManifest("http://panel.example.com:8080/live/user/pass/12345.ts"))
+        XCTAssertTrue(LiveStreamRouting.isStreamingManifest("http://panel.example.com/get.php?username=u&password=p&type=m3u8"))
+        XCTAssertTrue(LiveStreamRouting.isStreamingManifest("https://proxy.example.com/stream?output=HLS&id=9"))
+        XCTAssertTrue(LiveStreamRouting.isStreamingManifest("https://proxy.example.com/play?url=https://cdn.example.com/x/index.m3u8"))
+    }
+
+    func testFilesAreNotStreaming() {
+        let files = [
+            "https://download.real-debrid.com/d/ABCDEF/Movie.2024.2160p.mkv",
+            "https://cdn.torbox.app/dl/file.mp4?token=xyz",
+            "https://example.com/videos/episode.ts",          // a .ts file outside a /live/ path
+            "https://example.com/m3u8/movie.mp4",             // "m3u8" in a folder name only
+            "https://example.com/watch?type=movie&id=1",
+            "https://example.com/livestream/recording.mkv",
+            "magnet:?xt=urn:btih:abcdef",
+            "file:///var/mobile/index.m3u8",
+            "",
+            "not a url",
+        ]
+        for url in files { XCTAssertFalse(LiveStreamRouting.isStreamingManifest(url), url) }
+    }
+
+    func testOnlyTheDefaultRouteDefersToNuvio() {
+        let hls = "https://cdn.example.com/live/index.m3u8"
+        let mkv = "https://download.real-debrid.com/d/X/Movie.mkv"
+        XCTAssertTrue(LiveStreamRouting.playsInNuvio(urlString: hls, defaultRoute: true))
+        XCTAssertFalse(LiveStreamRouting.playsInNuvio(urlString: hls, defaultRoute: false), "long-press Play in Infuse keeps its choice")
+        XCTAssertFalse(LiveStreamRouting.playsInNuvio(urlString: mkv, defaultRoute: true), "debrid files still go to Infuse")
+    }
+}
