+++ b/iosApp/NuvioTV/Screens/Player/LiveStreamRouting.swift
@@ -0,0 +1,45 @@
+import Foundation
+
+/// Streaming links (HLS / DASH manifests, IPTV live TS) play in NuvioTV's own player even when
+/// an external player (Infuse) is the viewer's default. Only the default route defers: a long-press
+/// "Play in <player>" still hands off, since the viewer asked for that player by name.
+///
+/// Decided from the link alone, before anything plays: a manifest is the "m3u8 or equivalent" the
+/// owner named, and live channels come as one. Debrid links (mp4 / mkv files) are never manifests,
+/// so movies and series still go to Infuse.
+///
+/// Pure, no player state: `LiveStreamRoutingTests` drives it.
+nonisolated enum LiveStreamRouting {
+    /// Path extensions of a streaming manifest: HLS (`m3u8`, plain `m3u` playlists) and DASH (`mpd`).
+    static let manifestExtensions: Set<String> = ["m3u8", "m3u", "mpd"]
+    /// Query keys IPTV panels and proxies use to name the output format (`?type=m3u8`, `output=hls`).
+    static let formatQueryKeys: Set<String> = ["type", "format", "output", "ext", "extension", "container"]
+    /// Values of those keys that mean a streaming manifest.
+    static let manifestFormatValues: Set<String> = ["m3u8", "m3u", "hls", "mpd", "dash"]
+
+    /// True when `urlString` is an http(s) link to a streaming manifest, or to an IPTV live channel
+    /// (`…/live/…/<id>.ts`, the Xtream Codes layout).
+    static func isStreamingManifest(_ urlString: String) -> Bool {
+        let trimmed = urlString.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let parts = URLComponents(string: trimmed),
+              let scheme = parts.scheme?.lowercased(), scheme == "http" || scheme == "https" else { return false }
+        let path = parts.percentEncodedPath.removingPercentEncoding?.lowercased() ?? parts.path.lowercased()
+        let ext = (path as NSString).pathExtension
+        if manifestExtensions.contains(ext) { return true }
+        if ext == "ts", path.split(separator: "/").contains("live") { return true }
+        for item in parts.queryItems ?? [] {
+            let value = (item.value ?? "").lowercased()
+            if formatQueryKeys.contains(item.name.lowercased()), manifestFormatValues.contains(value) { return true }
+            // A proxy that carries the real link in a parameter (`?url=https://…/index.m3u8`).
+            if value.hasPrefix("http"), let inner = URLComponents(string: value),
+               manifestExtensions.contains((inner.path as NSString).pathExtension.lowercased()) { return true }
+        }
+        return false
+    }
+
+    /// Whether a handoff should play in NuvioTV instead. `defaultRoute` is the plain-Select /
+    /// auto-play route to the default external player; an explicit long-press choice is not.
+    static func playsInNuvio(urlString: String, defaultRoute: Bool) -> Bool {
+        defaultRoute && isStreamingManifest(urlString)
+    }
+}
