@@ -0,0 +1,81 @@
+package com.nuvio.app.features.plugins
+
+import javax.crypto.Cipher
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.SecretKeySpec
+import kotlin.random.Random
+import kotlin.test.Test
+import kotlin.test.assertContentEquals
+import kotlin.test.assertFailsWith
+
+/**
+ * Host-runnable check of the shared AES-GCM (the tvOS path feeds it CommonCrypto's public
+ * AES-ECB; here the JDK's AES-ECB stands in) against the JDK's own AES/GCM/NoPadding and the
+ * GCM spec vectors. tvosTest/PluginCryptoGcmTest covers the same vectors through CCCrypt.
+ */
+class AesGcmJvmTest {
+
+    private fun ecb(key: ByteArray): (ByteArray) -> ByteArray = { blocks ->
+        Cipher.getInstance("AES/ECB/NoPadding").apply { init(Cipher.ENCRYPT_MODE, SecretKeySpec(key, "AES")) }.doFinal(blocks)
+    }
+
+    private fun jdkSeal(key: ByteArray, iv: ByteArray, plain: ByteArray): ByteArray =
+        Cipher.getInstance("AES/GCM/NoPadding")
+            .apply { init(Cipher.ENCRYPT_MODE, SecretKeySpec(key, "AES"), GCMParameterSpec(128, iv)) }
+            .doFinal(plain)
+
+    private fun hex(value: String): ByteArray = ByteArray(value.length / 2) { value.substring(it * 2, it * 2 + 2).toInt(16).toByte() }
+
+    @Test
+    fun specTestCase3() {
+        val key = hex("feffe9928665731c6d6a8f9467308308")
+        val iv = hex("cafebabefacedbaddecaf888")
+        val plain = hex(
+            "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72" +
+                "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255",
+        )
+        val sealed = hex(
+            "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e" +
+                "21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f5985" +
+                "4d5c2af327cd64a62cf35abd2ba6fab4",
+        )
+        assertContentEquals(sealed, AesGcm.seal(iv, plain, ecb(key)))
+        assertContentEquals(plain, AesGcm.open(iv, sealed, ecb(key)))
+    }
+
+    @Test
+    fun emptyPlaintextIsTagOnly() {
+        val tag = hex("58e2fccefa7e3061367f1d57a4e7455a")
+        assertContentEquals(tag, AesGcm.seal(ByteArray(12), ByteArray(0), ecb(ByteArray(16))))
+        assertContentEquals(ByteArray(0), AesGcm.open(ByteArray(12), tag, ecb(ByteArray(16))))
+    }
+
+    @Test
+    fun matchesJdkAcrossKeyIvAndDataSizes() {
+        val random = Random(90338)
+        for (keySize in listOf(16, 24, 32)) {
+            for (ivSize in listOf(1, 8, 12, 13, 16, 17, 32, 60)) {
+                for (length in listOf(0, 1, 15, 16, 17, 31, 32, 33, 133, 1000)) {
+                    val key = random.nextBytes(keySize)
+                    val iv = random.nextBytes(ivSize)
+                    val plain = random.nextBytes(length)
+                    val sealed = AesGcm.seal(iv, plain, ecb(key))
+                    assertContentEquals(jdkSeal(key, iv, plain), sealed, "key=$keySize iv=$ivSize len=$length")
+                    assertContentEquals(plain, AesGcm.open(iv, sealed, ecb(key)))
+                }
+            }
+        }
+    }
+
+    @Test
+    fun tamperedInputFailsAndShortInputIsRejected() {
+        val key = ByteArray(32) { it.toByte() }
+        val iv = ByteArray(12) { (it * 3).toByte() }
+        val sealed = AesGcm.seal(iv, ByteArray(40) { it.toByte() }, ecb(key))
+        for (index in listOf(0, 39, 40, sealed.size - 1)) {
+            val tampered = sealed.copyOf().also { it[index] = (it[index].toInt() xor 0x01).toByte() }
+            assertFailsWith<IllegalStateException> { AesGcm.open(iv, tampered, ecb(key)) }
+        }
+        assertFailsWith<IllegalArgumentException> { AesGcm.open(iv, ByteArray(15), ecb(key)) }
+    }
+}
