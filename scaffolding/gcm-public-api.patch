@@ -0,0 +1,150 @@
+package com.nuvio.app.features.plugins
+
+/**
+ * AES-GCM (NIST SP 800-38D) built on a plain AES block cipher, so the Apple targets need only
+ * the public CommonCrypto `CCCrypt` (ECB) entry point. The CommonCrypto GCM functions
+ * (`CCCryptorGCMOneshotEncrypt` / `CCCryptorGCMOneshotDecrypt`) are SPI: App Store Connect
+ * rejects binaries that reference them (ITMS-90338, NuvioTV build 154).
+ *
+ * Layout matches WebCrypto/CryptoJS peers: output is ciphertext||tag, 128-bit tag, empty AAD.
+ * [encryptBlocks] must AES-ECB-encrypt its input (a whole number of 16-byte blocks, no padding)
+ * with the caller's key and return an array of the same size.
+ */
+internal object AesGcm {
+    const val TAG_LENGTH = 16
+    private const val BLOCK = 16
+
+    /** Returns ciphertext||tag. */
+    fun seal(iv: ByteArray, plaintext: ByteArray, encryptBlocks: (ByteArray) -> ByteArray): ByteArray {
+        require(iv.isNotEmpty()) { "AES-GCM requires an IV" }
+        val (hHi, hLo) = hashSubkey(encryptBlocks)
+        val stream = keystream(counterZero(iv, hHi, hLo), plaintext.size, encryptBlocks)
+        val cipherText = ByteArray(plaintext.size) { i -> (plaintext[i].toInt() xor stream[BLOCK + i].toInt()).toByte() }
+        return cipherText + tag(cipherText, stream, hHi, hLo)
+    }
+
+    /**
+     * Takes ciphertext||tag and returns the plaintext. Throws [IllegalArgumentException] when the
+     * input is shorter than a tag and [IllegalStateException] when the tag does not verify; no
+     * plaintext is produced before the tag has been checked.
+     */
+    fun open(iv: ByteArray, sealed: ByteArray, encryptBlocks: (ByteArray) -> ByteArray): ByteArray {
+        require(iv.isNotEmpty()) { "AES-GCM requires an IV" }
+        require(sealed.size >= TAG_LENGTH) { "Data too short for GCM decryption" }
+        val cipherLength = sealed.size - TAG_LENGTH
+        val cipherText = sealed.copyOfRange(0, cipherLength)
+        val (hHi, hLo) = hashSubkey(encryptBlocks)
+        val stream = keystream(counterZero(iv, hHi, hLo), cipherLength, encryptBlocks)
+        val expected = tag(cipherText, stream, hHi, hLo)
+        var diff = 0
+        for (i in 0 until TAG_LENGTH) {
+            diff = diff or (expected[i].toInt() xor sealed[cipherLength + i].toInt())
+        }
+        if (diff != 0) error("AES-GCM decryption failed (tag verification failed)")
+        return ByteArray(cipherLength) { i -> (cipherText[i].toInt() xor stream[BLOCK + i].toInt()).toByte() }
+    }
+
+    // H = E_K(0^128), as two big-endian 64-bit halves.
+    private fun hashSubkey(encryptBlocks: (ByteArray) -> ByteArray): Pair<Long, Long> {
+        val h = encryptBlocks(ByteArray(BLOCK))
+        check(h.size == BLOCK) { "AES block cipher returned ${h.size} bytes for one block" }
+        return readLong(h, 0) to readLong(h, 8)
+    }
+
+    // J0: IV||0^31||1 for the standard 96-bit IV, GHASH(IV padded || 0^64 || [len(IV)]_64) otherwise.
+    private fun counterZero(iv: ByteArray, hHi: Long, hLo: Long): ByteArray {
+        val j0 = ByteArray(BLOCK)
+        if (iv.size == 12) {
+            iv.copyInto(j0)
+            j0[15] = 1
+            return j0
+        }
+        val state = LongArray(2)
+        ghashUpdate(state, iv, hHi, hLo)
+        ghashBlock(state, 0L, iv.size.toLong() * 8, hHi, hLo)
+        writeLong(j0, 0, state[0])
+        writeLong(j0, 8, state[1])
+        return j0
+    }
+
+    // E_K(J0) || E_K(J0+1) || ... : block 0 masks the tag, the rest is the CTR keystream.
+    private fun keystream(j0: ByteArray, dataLength: Int, encryptBlocks: (ByteArray) -> ByteArray): ByteArray {
+        val blocks = 1 + (dataLength + BLOCK - 1) / BLOCK
+        val counters = ByteArray(blocks * BLOCK)
+        var counter = ((j0[12].toInt() and 0xff) shl 24) or ((j0[13].toInt() and 0xff) shl 16) or
+            ((j0[14].toInt() and 0xff) shl 8) or (j0[15].toInt() and 0xff)
+        for (b in 0 until blocks) {
+            val offset = b * BLOCK
+            j0.copyInto(counters, offset, 0, 12)
+            counters[offset + 12] = (counter ushr 24).toByte()
+            counters[offset + 13] = (counter ushr 16).toByte()
+            counters[offset + 14] = (counter ushr 8).toByte()
+            counters[offset + 15] = counter.toByte()
+            counter += 1 // inc32: wraps modulo 2^32
+        }
+        val stream = encryptBlocks(counters)
+        check(stream.size == counters.size) { "AES block cipher returned ${stream.size} bytes for ${counters.size}" }
+        return stream
+    }
+
+    // T = E_K(J0) xor GHASH(C padded || [len(A)=0]_64 || [len(C)]_64).
+    private fun tag(cipherText: ByteArray, stream: ByteArray, hHi: Long, hLo: Long): ByteArray {
+        val state = LongArray(2)
+        ghashUpdate(state, cipherText, hHi, hLo)
+        ghashBlock(state, 0L, cipherText.size.toLong() * 8, hHi, hLo)
+        val out = ByteArray(TAG_LENGTH)
+        writeLong(out, 0, state[0] xor readLong(stream, 0))
+        writeLong(out, 8, state[1] xor readLong(stream, 8))
+        return out
+    }
+
+    // Absorbs data in 16-byte blocks, zero-padding the last partial block.
+    private fun ghashUpdate(state: LongArray, data: ByteArray, hHi: Long, hLo: Long) {
+        var offset = 0
+        while (offset + BLOCK <= data.size) {
+            ghashBlock(state, readLong(data, offset), readLong(data, offset + 8), hHi, hLo)
+            offset += BLOCK
+        }
+        if (offset < data.size) {
+            val last = ByteArray(BLOCK)
+            data.copyInto(last, 0, offset, data.size)
+            ghashBlock(state, readLong(last, 0), readLong(last, 8), hHi, hLo)
+        }
+    }
+
+    // state = (state xor block) * H in GF(2^128), SP 800-38D algorithm 1 (bit 0 = most significant).
+    private fun ghashBlock(state: LongArray, blockHi: Long, blockLo: Long, hHi: Long, hLo: Long) {
+        val xHi = state[0] xor blockHi
+        val xLo = state[1] xor blockLo
+        var zHi = 0L
+        var zLo = 0L
+        var vHi = hHi
+        var vLo = hLo
+        for (i in 0 until 128) {
+            val bit = if (i < 64) (xHi ushr (63 - i)) and 1L else (xLo ushr (127 - i)) and 1L
+            if (bit != 0L) {
+                zHi = zHi xor vHi
+                zLo = zLo xor vLo
+            }
+            val carry = vLo and 1L
+            vLo = (vLo ushr 1) or (vHi shl 63)
+            vHi = vHi ushr 1
+            if (carry != 0L) vHi = vHi xor REDUCTION
+        }
+        state[0] = zHi
+        state[1] = zLo
+    }
+
+    // R = 11100001 || 0^120, high half.
+    private const val REDUCTION = -0x1f00000000000000L // 0xE1 shl 56
+
+    private fun readLong(bytes: ByteArray, offset: Int): Long {
+        var value = 0L
+        for (i in 0 until 8) value = (value shl 8) or (bytes[offset + i].toLong() and 0xff)
+        return value
+    }
+
+    private fun writeLong(bytes: ByteArray, offset: Int, value: Long) {
+        for (i in 0 until 8) bytes[offset + i] = (value ushr (56 - 8 * i)).toByte()
+    }
+}
